# --- required ---
DATABASE_URL=postgres://postgres:password@localhost:5432/beads
# set to true for Neon / Supabase / most cloud databases
DATABASE_SSL=false
# long random string; changing it logs everyone out
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# comma-separated origins allowed to call the API from a browser, or *
CORS_ORIGIN=*

# how often overdue checks run
ALERT_INTERVAL_MINUTES=5

# --- WhatsApp Cloud API (optional; leave empty to use tap-to-send links) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pick-any-secret-word
WA_APP_SECRET=
WA_API_VERSION=v21.0
WA_TEMPLATE_LANG=en
WA_TEMPLATE_FACTORY=new_order_factory
WA_TEMPLATE_FACTORY_BUTTON=true
WA_TEMPLATE_CUSTOMER=order_ready_customer
